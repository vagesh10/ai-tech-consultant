# Preserve task repositories outside the root commit
task1-knowledge-brain/.git/
task2-inbox-agent/.git/
task3-meeting-to-sow/.git/

# Python environments and caches
**/.venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.coverage

# Node.js dependencies and generated output
**/node_modules/
**/dist/
**/coverage/

# Secrets and environment files
**/.env
**/.env.*
!**/.env.example

# Local databases, indexes, and generated data
**/data/
!task2-inbox-agent/data/
task2-inbox-agent/data/*
!task2-inbox-agent/data/email_dataset_50.json
!task2-inbox-agent/data/classification_eval_20.json
**/chroma_db/
**/*.db
**/*.sqlite
**/*.sqlite3

# Logs and editor files
**/*.log
.vscode/
.DS_Store
Thumbs.db
